{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-sonnet-4-6",
  "env": {
    // "MAX_THINKING_TOKENS": "10000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70"
  },
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/pipeline-logger.sh\" SubagentStart'"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/pipeline-logger.sh\" SubagentStop'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/pipeline-logger.sh\" PostToolUse'"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/pipeline-logger.sh\" PreCompact'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/pipeline-logger.sh\" SessionStart compact'"
          }
        ]
      }
    ]
  }
}
