# Quarto cache and temporary files
/.quarto/
**/.quarto/

# Rendered output (regenerated on build)
_book/
_site/

# Local HTML preview files (should not be committed)
**/*_files/
**/*.html
!_extensions/**/*.html

# IDE / Editor
.obsidian/
.vscode/
.idea/

# Environment variables
.env

# OS files
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
*/.jupyter_cache/
.jupyter_cache/
_freeze/
chapters.yml

# Downloaded sources (large, user-specific)
sources/*
# !sources/.gitkeep

# User-provided PDFs (processed → sources/user-* which IS tracked)
# user-sources/*.pdf
# user-sources/*.PDF

# Pipeline diagnostics (committed by pipeline agents, not local ignores)
# diagnostics/ — intentionally NOT ignored (tracked by git checkpoints)

# Browser profiles for authenticated extraction (contain session cookies)
scripts/.browser-profiles/

# NOTE: _extensions/ is intentionally NOT ignored.
# It contains Quarto extensions needed for rendering.
Probability/probabilitycourse.com/*